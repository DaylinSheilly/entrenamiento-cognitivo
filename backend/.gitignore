# 🚀 Ignorar dependencias de Node.js
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 🛑 Archivos de configuración de entorno (¡No subir credenciales!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 🔧 Archivos de logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
debug.log
pids/
*.pid
*.seed
*.pid.lock

# 📂 Cachés y directorios temporales
tmp/
dist/
build/
.cache/
.vscode/
.DS_Store

# ⚙️ Archivos de procesos de ejecución
*.sqlite
*.sqlite3
*.bak
*.swp

# 🚀 Dependencias de producción de algunos frameworks
functions/node_modules/

# 🛠️ Ignorar archivos específicos de IDEs y editores de código
.idea/
.vscode/
*.sublime-workspace

# 📦 Paquetes de sistema
package-lock.json
yarn.lock

# 🔥 Ignorar cualq
node_modules/
